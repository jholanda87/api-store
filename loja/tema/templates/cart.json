{
  "sections": {
    "aviso": {
      "type": "modestino-carrinho-aviso",
      "settings": {}
    },
    "cart-section": {
      "type": "main-cart",
      "blocks": {
        "cart-page-title": {
          "type": "_cart-title",
          "static": true,
          "settings": {
            "title": "Seu carrinho",
            "show_count": true,
            "type_preset": "h3",
            "alignment": "left",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-items": {
          "type": "_cart-products",
          "static": true,
          "settings": {
            "gap": 24,
            "image_ratio": "portrait",
            "dividers": true,
            "vendor": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-summary": {
          "type": "_cart-summary",
          "static": true,
          "settings": {
            "extend_summary": false,
            "background_color": "#E4DDD0",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 8
          },
          "blocks": {}
        }
      },
      "settings": {
        "section_width": "page-width",
        "padding-block-start": 24,
        "padding-block-end": 64
      }
    }
  },
  "order": [
    "aviso",
    "cart-section"
  ]
}
