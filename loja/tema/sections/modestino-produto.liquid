{%- comment -%}
  S03 — Camiseta Básica. Cor troca foto e fundo; tamanho P–GG com a medida embaixo;
  calculadora pela largura de uma camiseta do cliente; frete e troca antes do botão.
  Formulário simples para /cart/add (funciona sem JavaScript: escolhe pelo select escondido).
{%- endcomment -%}
{%- liquid
  assign selecionada = product.selected_variant
  assign inicial = product.selected_or_first_available_variant
  assign cor_inicial = inicial.option1
  assign larguras = section.settings.larguras | split: ','
  assign torax = section.settings.torax | split: ','
  assign wa = section.settings.whatsapp
-%}
<div class="m-wrap m-prod" data-produto id="produto-{{ section.id }}">
  <div class="m-galeria" data-galeria data-cor="{{ cor_inicial }}">
    <ul class="m-galeria__lista">
      {%- for media in product.media -%}
        {%- liquid
          assign alt = media.alt | downcase
          assign cor_foto = ''
          if alt contains 'preta'
            assign cor_foto = 'Preto'
          elsif alt contains 'mapple'
            assign cor_foto = 'Mapple Brown'
          elsif alt contains 'off white'
            assign cor_foto = 'Off White'
          endif
        -%}
        <li data-cor-foto="{{ cor_foto }}" {% if cor_foto != '' and cor_foto != cor_inicial %}hidden{% endif %}>
          {{ media.preview_image | image_url: width: 1080 | image_tag: loading: 'eager', sizes: '(max-width: 859px) 82vw, 55vw', widths: '540, 720, 1080', alt: media.alt }}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="m-info">
    <h1>{{ product.title }}</h1>
    <p class="m-info__lead">{{ section.settings.lead }}</p>
    <p class="m-preco"><span data-preco>{{ inicial.price | money }}</span><small>no Pix ou no cartão</small></p>

    <form method="post" action="{{ routes.cart_add_url }}" class="m-form" data-form novalidate>
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">

      <fieldset class="m-campo">
        <legend>Cor: <span data-cor-nome>{{ cor_inicial }}</span></legend>
        <div class="m-cores">
          {%- for cor in product.options_with_values[0].values -%}
            <div class="m-cor">
              <input type="radio" name="m-cor" id="cor-{{ section.id }}-{{ forloop.index }}" value="{{ cor }}" {% if cor == cor_inicial %}checked{% endif %}>
              <label for="cor-{{ section.id }}-{{ forloop.index }}" data-cor="{{ cor }}" title="{{ cor }}"><span class="m-sr">{{ cor }}</span></label>
            </div>
          {%- endfor -%}
        </div>
      </fieldset>

      <fieldset class="m-campo">
        <legend>Tamanho <span>· largura de axila a axila</span></legend>
        <div class="m-tams" data-tams>
          {%- for tam in product.options_with_values[1].values -%}
            {%- liquid
              assign disponivel = false
              for v in product.variants
                if v.option1 == cor_inicial and v.option2 == tam and v.available
                  assign disponivel = true
                endif
              endfor
            -%}
            <div class="m-tam">
              <input type="radio" name="m-tam" id="tam-{{ section.id }}-{{ forloop.index }}" value="{{ tam }}"
                {% unless disponivel %}disabled{% endunless %}
                {% if selecionada and selecionada.option2 == tam and disponivel %}checked{% endif %}>
              <label for="tam-{{ section.id }}-{{ forloop.index }}">{{ tam }}<small>{{ larguras[forloop.index0] }} cm</small></label>
            </div>
          {%- endfor -%}
        </div>
        <p class="m-aviso-estoque" data-aviso aria-live="polite"></p>
      </fieldset>

      <details class="m-calc">
        <summary>Não sabe o tamanho? Meça uma camiseta sua</summary>
        <div class="m-calc__corpo">
          <p>Pegue uma camiseta que veste bem em você, deite numa mesa e meça de axila a axila, em centímetros.</p>
          <div class="m-calc__linha">
            <label for="calc-{{ section.id }}">Largura da sua camiseta (cm)
              <input class="m-input" id="calc-{{ section.id }}" type="number" inputmode="decimal" min="40" max="70" step="0.5" placeholder="ex.: 54" data-calc aria-describedby="calc-res-{{ section.id }}">
            </label>
            <button type="button" class="m-btn m-btn--secundario" data-calc-ok>Ver meu tamanho</button>
          </div>
          <p class="m-calc__res" id="calc-res-{{ section.id }}" data-calc-res aria-live="polite"></p>
          <div class="m-tabela-caixa">
            <table class="m-tabela">
              <caption class="m-sr">Medidas da Camiseta Básica Modestino</caption>
              <thead><tr><th scope="col">Tamanho</th>{% for tam in product.options_with_values[1].values %}<th scope="col">{{ tam }}</th>{% endfor %}</tr></thead>
              <tbody>
                <tr><th scope="row">Largura</th>{% for l in larguras %}<td>{{ l }} cm</td>{% endfor %}</tr>
                <tr><th scope="row">Tórax</th>{% for t in torax %}<td>{{ t }} cm</td>{% endfor %}</tr>
              </tbody>
            </table>
          </div>
        </div>
      </details>

      {%- render 'modestino-servico' -%}

      <div class="m-sr">
        <label for="variante-{{ section.id }}">Cor e tamanho</label>
        <select name="id" id="variante-{{ section.id }}" data-variante>
          {%- for v in product.variants -%}
            <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %} {% if v.id == inicial.id %}selected{% endif %}>{{ v.title }}</option>
          {%- endfor -%}
        </select>
      </div>
      <input type="hidden" name="quantity" value="1">

      <div class="m-comprar">
        <button type="submit" class="m-btn m-btn--primario m-btn--largo" data-comprar {% unless selecionada and selecionada.available %}aria-disabled="true"{% endunless %}>
          {%- if selecionada and selecionada.available -%}Adicionar ao carrinho · {{ selecionada.price | money }}{%- else -%}Escolha o tamanho{%- endif -%}
        </button>
        <p class="m-form-erro" data-erro role="alert" hidden></p>
        <a class="m-btn m-btn--secundario m-btn--largo" href="{{ wa }}" target="_blank" rel="noopener">{% render 'modestino-icone', nome: 'whatsapp' %}Tirar dúvida no WhatsApp</a>
      </div>
    </form>

    <div class="m-desc">
      <h2>Sobre a peça</h2>
      {{ product.description }}
    </div>
  </div>
</div>

<script type="application/json" data-variantes>
  [{%- for v in product.variants -%}{"id":{{ v.id }},"cor":{{ v.option1 | json }},"tam":{{ v.option2 | json }},"ok":{{ v.available }},"qtd":{% if v.inventory_management %}{{ v.inventory_quantity }}{% else %}99{% endif %},"preco":{{ v.price | money | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
</script>
<script>
  (() => {
    const raiz = document.getElementById('produto-{{ section.id }}');
    const dados = raiz.parentElement.querySelector('[data-variantes]');
    let variantes = [];
    try { variantes = JSON.parse(dados.textContent); } catch (e) {}
    const larguras = {{ larguras | json }}.map(Number);
    const tamanhos = {{ product.options_with_values[1].values | json }};
    const form = raiz.querySelector('[data-form]');
    const galeria = raiz.querySelector('[data-galeria]');
    const select = raiz.querySelector('[data-variante]');
    const botao = raiz.querySelector('[data-comprar]');
    const aviso = raiz.querySelector('[data-aviso]');
    const erro = raiz.querySelector('[data-erro]');
    const corNome = raiz.querySelector('[data-cor-nome]');
    const wa = {{ wa | json }};
    const BAIXO = {{ section.settings.ultimas | default: 2 }};

    const cor = () => form.querySelector('input[name="m-cor"]:checked')?.value;
    const tam = () => form.querySelector('input[name="m-tam"]:checked')?.value;
    const achar = (c, t) => variantes.find((v) => v.cor === c && v.tam === t);

    function avise(c, t) {
      const texto = encodeURIComponent('Oi! Quero ser avisado quando a camiseta ' + c + ' ' + t + ' voltar.');
      return wa.split('?')[0] + '?text=' + texto;
    }

    function atualizar() {
      const c = cor();
      const t = tam();
      corNome.textContent = c;
      galeria.dataset.cor = c;
      galeria.querySelectorAll('[data-cor-foto]').forEach((li) => {
        li.hidden = li.dataset.corFoto !== '' && li.dataset.corFoto !== c;
      });
      const esgotados = [];
      form.querySelectorAll('input[name="m-tam"]').forEach((r) => {
        const v = achar(c, r.value);
        r.disabled = !v || !v.ok;
        if (r.disabled) { esgotados.push(r.value); if (r.checked) r.checked = false; }
      });
      const v = tam() ? achar(c, tam()) : null;
      aviso.innerHTML = '';
      if (v && v.ok) {
        select.value = String(v.id);
        botao.removeAttribute('aria-disabled');
        botao.textContent = 'Adicionar ao carrinho · ' + v.preco;
        if (v.qtd > 0 && v.qtd <= BAIXO) aviso.textContent = v.qtd === 1 ? 'Última peça nesse tamanho.' : 'Últimas ' + v.qtd + ' peças nesse tamanho.';
        const u = new URL(location.href); u.searchParams.set('variant', v.id); history.replaceState(null, '', u);
      } else {
        botao.setAttribute('aria-disabled', 'true');
        botao.textContent = 'Escolha o tamanho';
      }
      if (esgotados.length && !(v && v.ok)) {
        const a = document.createElement('a');
        a.href = avise(c, esgotados.join(', ')); a.target = '_blank'; a.rel = 'noopener';
        a.textContent = 'Avise-me quando voltar';
        aviso.append(c + ' ' + esgotados.join(', ') + ' esgotado. ', a);
      }
      erro.hidden = true;
    }

    form.addEventListener('change', (ev) => { if (ev.target.name === 'm-cor' || ev.target.name === 'm-tam') atualizar(); });
    form.addEventListener('submit', (ev) => {
      if (botao.getAttribute('aria-disabled') === 'true') {
        ev.preventDefault();
        erro.textContent = 'Escolha o tamanho antes de adicionar.';
        erro.hidden = false;
        const primeiro = form.querySelector('input[name="m-tam"]:not(:disabled)');
        if (primeiro) primeiro.focus();
      }
    });

    // Calculadora: largura da camiseta do cliente -> tamanho mais próximo da tabela.
    const calc = raiz.querySelector('[data-calc]');
    const res = raiz.querySelector('[data-calc-res]');
    function calcular() {
      const n = parseFloat(String(calc.value).replace(',', '.'));
      res.removeAttribute('data-erro');
      calc.removeAttribute('aria-invalid');
      if (!calc.value) { res.textContent = ''; return; }
      if (isNaN(n) || n < 45 || n > 66) {
        res.dataset.erro = '';
        calc.setAttribute('aria-invalid', 'true');
        res.textContent = 'Meça deitada, de axila a axila. A tabela vai de ' + larguras[0] + ' a ' + larguras[larguras.length - 1] + ' cm.';
        return;
      }
      let i = 0;
      larguras.forEach((l, k) => { if (Math.abs(l - n) < Math.abs(larguras[i] - n)) i = k; });
      const t = tamanhos[i];
      const r = form.querySelector('input[name="m-tam"][value="' + t + '"]');
      let msg = 'Sua camiseta tem ' + n.toString().replace('.', ',') + ' cm: o seu tamanho é ' + t + ' (' + larguras[i] + ' cm).';
      if (r && !r.disabled) { r.checked = true; atualizar(); msg += ' Já deixamos marcado.'; }
      else msg += ' Ele está esgotado em ' + cor() + '; veja outra cor.';
      res.textContent = msg;
    }
    raiz.querySelector('[data-calc-ok]').addEventListener('click', calcular);
    calc.addEventListener('keydown', (ev) => { if (ev.key === 'Enter') { ev.preventDefault(); calcular(); } });

    atualizar();
  })();
</script>

{% schema %}
{
  "name": "Produto Modestino",
  "settings": [
    { "type": "textarea", "id": "lead", "label": "Frase abaixo do título", "default": "Lisa, sem logo. Só o nome MODESTINO pequeno na nuca, por dentro." },
    { "type": "text", "id": "larguras", "label": "Larguras P,M,G,GG (cm)", "default": "51,54,57,60" },
    { "type": "text", "id": "torax", "label": "Tórax P,M,G,GG (cm)", "default": "102,108,114,120" },
    { "type": "number", "id": "ultimas", "label": "Avisar \"últimas peças\" a partir de", "default": 2 },
    { "type": "text", "id": "whatsapp", "label": "Link do WhatsApp", "default": "https://wa.me/5585981559590?text=Oi%21%20Vim%20pela%20loja%20da%20MODESTINO%20e%20tenho%20uma%20d%C3%BAvida." }
  ]
}
{% endschema %}
