{%- comment -%}
  S01, primeira tela. Foto em tela cheia (as três cores lado a lado no computador, uma no celular),
  título definido pelo Jorge (27/10), uma linha e um botão. Fotos: frentes da Camiseta Básica (provisórias).
{%- endcomment -%}
{%- liquid
  assign camiseta = all_products[section.settings.produto]
  assign fotos = ''
-%}
<section class="m-hero" aria-labelledby="hero-{{ section.id }}">
  <div class="m-hero__fotos m-esteira" id="esteira-{{ section.id }}">
    <div class="m-esteira__trilho">
      {%- for m in camiseta.media -%}
        {%- if m.alt contains 'de frente' -%}
          {%- assign alt = m.alt | downcase -%}
          <div class="m-hero__foto" data-cor="{% if alt contains 'mapple' %}m{% elsif alt contains 'off' %}o{% else %}p{% endif %}">
            {{ m.preview_image | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(max-width: 859px) 80vw, 34vw', widths: '540, 720, 900', alt: m.alt }}
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- for p in collections.all.products -%}
        {%- if p.tags contains 'basico' and p.tags contains 'progressivo' and p.handle != camiseta.handle -%}
          {%- for m in p.images -%}
            {%- assign alt = m.alt | downcase -%}
            <div class="m-hero__foto" data-cor="{% if alt contains 'mapple' %}m{% elsif alt contains 'off' %}o{% else %}p{% endif %}">
              {{ m | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(max-width: 859px) 80vw, 34vw', widths: '540, 720, 900', alt: m.alt }}
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="m-hero__texto">
    <div class="m-wrap">
      <h1 id="hero-{{ section.id }}">{{ section.settings.titulo }}</h1>
      <p class="m-hero__sub">{{ section.settings.subtitulo }}</p>
      <a class="m-btn m-btn--claro" href="{{ camiseta.url | default: '/products/camiseta-basica-modestino' }}">{{ section.settings.botao }}</a>
    </div>
  </div>
</section>
<script>
(() => {
  const e = document.getElementById('esteira-{{ section.id }}'); if (!e) return;
  const t = e.querySelector('.m-esteira__trilho');
  let f = [...t.children];
  // embaralha sem repetir cor nem arte em sequência
  for (let k = 0; k < 200; k++) {
    for (let i = f.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [f[i], f[j]] = [f[j], f[i]]; }
    if (f.every((x, i) => i === 0 || x.dataset.cor !== f[i - 1].dataset.cor) && f[0].dataset.cor !== f[f.length - 1].dataset.cor) break;
  }
  f.forEach(x => t.appendChild(x));
  f.forEach(x => { const c = x.cloneNode(true); c.setAttribute('aria-hidden', 'true'); c.querySelector('img').alt = ''; t.appendChild(c); });
  t.style.setProperty('--n', f.length);
  e.classList.add('m-esteira--viva');
})();
</script>

{% stylesheet %}
.m-esteira { display: block !important; overflow: hidden; background: #ECE7DE; }
.m-esteira__trilho { display: flex; height: 100%; width: max-content; }
.m-esteira .m-hero__foto { display: block !important; flex: 0 0 34vw; height: 100%; }
.m-esteira--viva .m-esteira__trilho { animation: m-esteira calc(var(--n) * 4s) linear infinite; }
@keyframes m-esteira { to { transform: translateX(-50%); } }
@media (max-width: 859px) { .m-esteira .m-hero__foto { flex-basis: 80vw; } }
@media (prefers-reduced-motion: reduce) { .m-esteira--viva .m-esteira__trilho { animation: none; } .m-esteira { overflow-x: auto; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Início: primeira tela",
  "settings": [
    { "type": "textarea", "id": "titulo", "label": "Título", "default": "Três cores, várias combinações." },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo", "default": "Camiseta básica masculina, produzida em Fortaleza." },
    { "type": "text", "id": "botao", "label": "Botão", "default": "Conhecer" },
    { "type": "text", "id": "produto", "label": "Handle do produto", "default": "camiseta-basica-modestino" }
  ],
  "presets": [{ "name": "Início: primeira tela" }]
}
{% endschema %}
