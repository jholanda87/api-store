{%- comment -%} Dúvidas frequentes resumidas na página inicial, com atendimento ao lado. {%- endcomment -%}
<section class="m-duvidas" aria-labelledby="duvidas-{{ section.id }}">
  <div class="m-wrap m-duvidas__grid">
    <div>
      <h2 id="duvidas-{{ section.id }}">{{ section.settings.titulo }}</h2>
      <p class="m-muted">{{ section.settings.texto }}</p>
      <a class="m-btn m-btn--secundario" href="{{ section.settings.whatsapp }}" target="_blank" rel="noopener">{% render 'modestino-icone', nome: 'whatsapp' %}WhatsApp</a>
    </div>
    <div class="m-faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.pergunta }}{% render 'modestino-icone', nome: 'mais' %}</summary>
          <div class="m-faq__resp">{{ block.settings.resposta }}</div>
        </details>
      {%- endfor -%}
      <p class="m-duvidas__todas"><a class="m-link" href="/pages/perguntas-frequentes">Todas as dúvidas</a></p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dúvidas (início)",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Dúvidas" },
    { "type": "text", "id": "texto", "label": "Texto", "default": "Atendimento via WhatsApp, todos os dias." },
    { "type": "text", "id": "whatsapp", "label": "Link do WhatsApp", "default": "https://wa.me/5585981559590?text=Oi%21%20Vim%20pela%20loja%20da%20MODESTINO%20e%20tenho%20uma%20d%C3%BAvida." }
  ],
  "blocks": [
    { "type": "pergunta", "name": "Pergunta", "settings": [
      { "type": "text", "id": "pergunta", "label": "Pergunta" },
      { "type": "richtext", "id": "resposta", "label": "Resposta" }
    ] }
  ],
  "presets": [{ "name": "Dúvidas (início)" }]
}
{% endschema %}
