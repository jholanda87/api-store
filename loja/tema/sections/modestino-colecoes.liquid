{%- comment -%} Faixa de coleções logo abaixo do cabeçalho, com "Monte a sua" em destaque. {%- endcomment -%}
{%- assign links = linklists[section.settings.menu].links -%}
<nav class="m-cols" aria-label="Coleções">
  <div class="m-wrap m-cols__lista">
    {%- for link in links -%}
      {%- if link.url contains 'monte-a-sua' -%}{%- continue -%}{%- endif -%}
      {%- assign h = link.url | split: '/' | last -%}{%- assign c = collections[h] -%}
      <a class="m-cols__item" href="{{ link.url }}">
        {%- if c.products.first.featured_image -%}{{ c.products.first.featured_image | image_url: width: 240 | image_tag: loading: 'eager', alt: '' }}{%- endif -%}
        <span>{{ link.title }}</span>
      </a>
    {%- endfor -%}
  </div>
  <div class="m-wrap">
    <a class="m-cols__monte" href="/pages/monte-a-sua">
      <span class="m-cols__monte-t">Monte a <em>sua</em></span>
      <span class="m-cols__monte-s">Escolha a cor, o tamanho e as artes da frente e das costas. O preço sai na hora.</span>
      <span class="m-cols__monte-b">Personalizar →</span>
    </a>
  </div>
</nav>

{% stylesheet %}
.m-cols{padding:16px 0 8px}
.m-cols__lista{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px}
.m-cols__item{flex:0 0 112px;scroll-snap-align:start;display:grid;gap:6px;text-align:center;text-decoration:none;color:var(--color-text,#22201D);font-size:.9rem}
.m-cols__item img{width:112px;height:112px;object-fit:cover;border-radius:50%;background:var(--color-surface,#E4DDD0)}
.m-cols__monte{display:grid;gap:4px;margin-top:12px;padding:20px 24px;border-radius:12px;background:var(--color-accent,#5B3F30);color:#ECE7DE;text-decoration:none}
.m-cols__monte-t{font-family:var(--font-display,'Instrument Serif',serif);font-size:2rem;line-height:1}
.m-cols__monte-s{opacity:.9}
.m-cols__monte-b{font-weight:600;margin-top:6px}
@media(min-width:860px){.m-cols__lista{justify-content:center}.m-cols__monte{grid-template-columns:auto 1fr auto;align-items:center;gap:24px}}
{% endstylesheet %}

{% schema %}
{ "name": "Faixa de coleções", "settings": [ { "type": "text", "id": "menu", "label": "Handle do menu", "default": "modestino-colecoes" } ], "presets": [{ "name": "Faixa de coleções" }] }
{% endschema %}
