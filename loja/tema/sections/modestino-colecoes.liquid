{%- comment -%} Nomes das coleções logo abaixo do cabeçalho; "Monte a sua" por último, em destaque. {%- endcomment -%}
{%- assign links = linklists[section.settings.menu].links -%}
<nav class="m-cols" aria-label="Coleções">
  <div class="m-wrap m-cols__lista">
    {%- for link in links -%}
      <a class="m-cols__item{% if link.url contains 'monte-a-sua' %} m-cols__monte{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </div>
</nav>

{% stylesheet %}
.m-cols{padding:12px 0;border-bottom:1px solid var(--color-border,#CBBFAE)}
.m-cols__lista{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.m-cols__item{display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border:1px solid var(--color-border,#CBBFAE);border-radius:999px;text-decoration:none;color:var(--color-text,#22201D);font-size:.95rem}
.m-cols__item.m-cols__monte{background:#5B3F30;border-color:#5B3F30;color:#ECE7DE;font-weight:600}
@media(min-width:860px){.m-cols{display:none}}
{% endstylesheet %}

{% schema %}
{ "name": "Faixa de coleções", "settings": [ { "type": "text", "id": "menu", "label": "Handle do menu", "default": "modestino-colecoes" } ], "presets": [{ "name": "Faixa de coleções" }] }
{% endschema %}
