{%- liquid
  assign links = section.settings.menu.links
-%}
<header class="m-cab">
  <div class="m-wrap m-cab__in">
    <a class="m-marca" href="{{ routes.root_url }}" aria-label="MODESTINO, página inicial">
      <img src="{{ 'cavalheiro-busto-carvao.png' | asset_url }}" alt="" width="34" height="40">
      <span>MODESTINO</span>
    </a>

    <nav class="m-nav" aria-label="Principal">
      {%- for link in links -%}
        <a href="{{ link.url }}" {% if link.url contains "monte-a-sua" %}class="m-nav__monte" {% endif %}{% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- else -%}
        <a href="/pages/trocas">Trocas</a>
        <a href="/pages/perguntas-frequentes">Dúvidas</a>
      {%- endfor -%}
    </nav>

    <div class="m-cab__acoes">
      <a class="m-sacola" href="{{ routes.cart_url }}" aria-label="Carrinho, {{ cart.item_count }} {% if cart.item_count == 1 %}peça{% else %}peças{% endif %}">
        {% render 'modestino-icone', nome: 'sacola' %}
        {%- if cart.item_count > 0 -%}<span class="m-sacola__n" aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
      </a>
      <details class="m-gaveta">
        <summary aria-label="Abrir menu">{% render 'modestino-icone', nome: 'menu' %}</summary>
        <nav class="m-gaveta__painel" aria-label="Menu">
          {%- for link in links -%}
            <a href="{{ link.url }}"{% if link.url contains "monte-a-sua" %} class="m-nav__monte"{% endif %}>{{ link.title }}</a>
          {%- else -%}
                <a href="/pages/trocas">Trocas</a>
            <a href="/pages/perguntas-frequentes">Dúvidas</a>
          {%- endfor -%}
        </nav>
      </details>
    </div>
  </div>
  <nav class="m-linhas" aria-label="Escolha a linha">
    <a class="m-linha" href="/pages/basicas"{% if page.handle == 'basicas' %} aria-current="page"{% endif %}><strong>Básicas</strong><small>Lisas · 3 cores</small></a>
    <a class="m-linha m-linha--monte" href="{{ routes.root_url }}"{% if template.name == 'index' %} aria-current="page"{% endif %}><strong>Monte a sua</strong><small>Cor + arte do seu jeito</small></a>
  </nav>
</header>

{% stylesheet %}
.m-nav a.m-nav__monte, .m-gaveta__painel a.m-nav__monte { background: var(--color-accent); color: var(--color-bg); padding: 0 16px; border-radius: 999px; }
.m-nav a.m-nav__monte:hover, .m-nav a.m-nav__monte[aria-current='page'] { text-decoration: none; background: var(--color-text); }
.m-linhas { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; max-width: 560px; margin: 0 auto; padding: 6px 16px 8px; box-sizing: border-box; }
.m-linha { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; min-height: 38px; padding: 3px 8px; border: 1.5px solid var(--color-text); border-radius: 10px; line-height: 1.15; color: var(--color-text); text-decoration: none; text-align: center; }
.m-linha strong { font-size: .88rem; }
.m-linha small { font-size: .62rem; opacity: .8; }
.m-linha--monte { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-bg); }
.m-linha[aria-current='page'] { outline: 2px solid var(--color-text); outline-offset: 2px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Cabeçalho Modestino",
  "tag": "div",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu (vazio = Camiseta, Kits, Trocas, Dúvidas)" }
  ]
}
{% endschema %}
